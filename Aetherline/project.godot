; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Aetherline"
config/description="A portable colony of humans and living creatures across an infinite scatter of procedurally generated worlds."
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.8", "GL Compatibility")

[autoload]

EventBus="*res://autoload/event_bus.gd"
SimulationBudget="*res://autoload/simulation_budget.gd"
GenomeDB="*res://autoload/genome_db.gd"
PlanetManager="*res://autoload/planet_manager.gd"
StoryDirector="*res://autoload/story_director.gd"
SaveSystem="*res://autoload/save_system.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[debug]

; Godot 4.8-dev promotes INFERENCE_ON_VARIANT to an error by default. Autoload
; singletons are untyped by Godot's own design (an autoload cannot carry a
; class_name without colliding with its own singleton), so `var x := Autoload.f()`
; is correct code that trips this warning in ~70 places. Demoted to a warning
; rather than silenced, so genuine Variant inference elsewhere still surfaces.
gdscript/warnings/inference_on_variant=1

[dotnet]

project/assembly_name="Aetherline"

